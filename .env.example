# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 新形式の publishable key（sb_publishable_...）または legacy anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# サーバー専用（絶対に NEXT_PUBLIC_ を付けない）
SUPABASE_SECRET_KEY=your-secret-key

# YouTube Data API v3（サーバー専用）
YOUTUBE_API_KEY=your-youtube-api-key
# 1日あたりのクォータ上限（デフォルト 10000）。マイページの残量表示に使う
# YOUTUBE_API_DAILY_QUOTA=10000

# Google OAuth（Supabase Auth の Google プロバイダと同一クライアント）
# YouTube 専用連携 + トークン自動更新に必要
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# サイト URL（OAuth リダイレクト用）
# ローカル: ブラウザで開くホストと揃える（127.0.0.1 推奨）
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# 本番（Vercel）: https://<名前>.vercel.app （末尾スラッシュなし）
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Cloud の「承認済みのリダイレクト URI」に必ず追加:
#   {NEXT_PUBLIC_SITE_URL}/api/youtube/oauth/callback
#   例: http://127.0.0.1:3000/api/youtube/oauth/callback
#   例: http://localhost:3000/api/youtube/oauth/callback
#   例: https://your-app.vercel.app/api/youtube/oauth/callback
# Supabase Auth の Redirect URLs にも:
#   {NEXT_PUBLIC_SITE_URL}/auth/callback
